{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npx vitest run *)",
      "Bash(npx tsc --noEmit *)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(!.env.example)",
      "Bash(vercel env pull *)",
      "Bash(npx vercel env pull *)",
      "Bash(npm run db:push *)",
      "Bash(npx drizzle-kit push *)",
      "Bash(drizzle-kit push *)"
    ]
  }
}
