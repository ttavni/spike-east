# ── Local dev. Copy to .env.local (gitignored) and `npm run db:up` for the Postgres below. ──
# These values are for your laptop only. Never put a real database URL or secret in this file.
DATABASE_URL="postgres://spike:spike@localhost:5432/spike"

# Signs the session cookie. Anyone who knows it can sign in as anyone, admin included.
# Production refuses to start sessions with this example or anything under 32 characters.
# Generate a real one with: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-please-0000000000000000000000"

# The shared sign-in code everyone types: 4 to 8 digits. Production needs 6+ to be worth having
# (guessing is rate-limited, but 4 digits still falls in about a day). Dev falls back to 0000.
SPIKE_PIN="0000"

# Admin code: unlocks score fixes, deletes and player management for an admin player, for
# 12 hours. Keep it to the admins, make it 8+ characters (four random words is best). Unset =
# admin stays locked.
SPIKE_ADMIN_CODE="dev-admin-code"

# Optional: the public URL used for share previews. On Vercel it's worked out automatically.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Production: set these in Vercel (Settings → Environment Variables), scoped to Production ──
# DATABASE_URL     = the Neon pooled connection string (postgresql://…-pooler…/db?sslmode=require)
# AUTH_SECRET      = a fresh `openssl rand -base64 32`
# SPIKE_PIN        = the real shared code you give the group (6-8 digits)
# SPIKE_ADMIN_CODE = the admins-only code
# Preview deployments get their own values (a Neon branch, their own secrets), never these.
